{
  "manifest_version": 3,
  "name": "领星出库批次助手",
  "version": "0.1.4",
  "description": "按 SKU 和采购单号自动选择领星 ERP 出库批次。",
  "permissions": ["activeTab", "sidePanel", "scripting"],
  "host_permissions": ["https://erp.lingxing.com/*"],
  "action": {
    "default_title": "打开出库批次助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "ui-dist/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://erp.lingxing.com/erp/msupply/FBAgenerateInvoice*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
